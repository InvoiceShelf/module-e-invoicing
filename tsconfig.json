{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@invoiceshelf/modules/frontend": ["vendor/invoiceshelf/modules/frontend/index.d.ts"],
      "@/*": ["resources/js/*"]
    }
  },
  "include": ["resources/js/**/*.ts", "resources/js/**/*.d.ts", "resources/js/**/*.vue"]
}
